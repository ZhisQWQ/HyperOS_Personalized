<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏背景 -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background" />

    <!-- 居中文字容器 -->
    <FrameLayout
        android:id="@+id/text_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:background="@drawable/card_stroke"
        android:foreground="@drawable/card_stroke"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="0dp">

        <!-- 模糊层 -->
        <ImageView
            android:id="@+id/blur_layer_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 文字内容容器 -->
        <FrameLayout
            android:id="@+id/text_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- 主页 -->
            <FrameLayout
                android:id="@+id/page_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <!-- 默认信息 -->
                <LinearLayout
                    android:id="@+id/page_home_default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HyperOS 个性化"
                        android:textColor="#000000"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="软件不需要任何权限\n在 LSPosed 中打开开关\n勾选哪个作用域就开启哪部分功能\n卸载重启恢复正常"
                        android:textColor="#000000"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="作者：Zhis | therqwq@outlook.com\n代码：Zhis、Qwen、Kimi、Deepseek"
                        android:textColor="#000000"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_github"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Github：ZhisQWQ"
                        android:textColor="#000000"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 功能列表 -->
                <LinearLayout
                    android:id="@+id/page_home_features"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HyperOS 个性化"
                        android:textColor="#000000"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="小米桌面：去除最近任务的清理按钮\n安全服务：去除危险操作的倒计时限制\nHTML 查看器：去除云控\nJoyose：去除云控\nAnalytics：去除遥测数据收集\n应用包管理组件：禁用推广\n禁用风险检测\n阻断云端配置下发\n禁用安全守护提示\n禁用频繁安装应用检查\n解锁系统应用安装限制\n禁止安装时上传应用信息"
                        android:textColor="#000000"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 设置页 -->
            <LinearLayout
                android:id="@+id/page_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仍在开发，敬请期待"
                    android:textColor="#000000"
                    android:textSize="18sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- 胶囊底栏 -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/capsule_stroke"
        android:foreground="@drawable/capsule_stroke"
        android:elevation="8dp">

        <!-- 模糊层 -->
        <ImageView
            android:id="@+id/blur_layer_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Tab 容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 主页 Tab -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tab_home"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/tab_bg_selector"
                    android:gravity="center"
                    android:text="主页"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 设置 Tab -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tab_settings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/tab_bg_selector"
                    android:gravity="center"
                    android:text="设置"
                    android:textColor="#66000000"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>